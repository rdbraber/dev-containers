// Config for opening other projects in a container from the prebuilt image.
// Build the image first from the dev-containers/terraform folder:
//   devcontainer build --workspace-folder . --image-name dev-containers:latest
// Features, extensions and settings are baked into the image; mounts are not
// (they are applied at container start), so they must be repeated here.
{
  "name": "Claude Code (project)",
  "image": "dev-containers:latest",
  "remoteUser": "vscode",
  "mounts": [
    "source=claude-code-config,target=/home/vscode/.claude,type=volume",
    // Host AWS config (read-write) and SSH config (read-only)
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.aws,target=/home/vscode/.aws,type=bind",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/vscode/.ssh,type=bind,readonly"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "postCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && mkdir -p /home/vscode/.claude/skills && cp -r /usr/local/share/claude-skills/. /home/vscode/.claude/skills/"
}
