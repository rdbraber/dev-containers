$-- Pandoc Typst template for md2pdf: A4, Noto Sans, left-aligned text, compact bold title.
$-- Based on pandoc's default.typst. Override defaults with -V papersize=, margin=, mainfont=,
$-- monofont=, fontsize=, lang=.
#import "@preview/merman:0.5.0": show-mermaid-blocks

#let horizontalrule = block(above: 1.2em, below: 1.2em, line(length: 100%, stroke: 0.5pt + luma(180)))

// GitHub alerts (> [!NOTE] etc.), produced by md2pdf.lua
#let alert-colors = (
  note: rgb("#0969da"), tip: rgb("#1a7f37"), important: rgb("#8250df"),
  warning: rgb("#9a6700"), caution: rgb("#cf222e"),
)
#let alert(kind, title, body) = {
  let color = alert-colors.at(kind)
  block(
    width: 100%, inset: (left: 10pt, right: 8pt, y: 8pt), radius: (right: 3pt),
    stroke: (left: 3pt + color), fill: color.lighten(93%),
  )[#text(fill: color, weight: "bold")[#title] #parbreak() #body]
}

// <kbd>, produced by md2pdf.lua
#let kbd(body) = box(
  stroke: 0.5pt + luma(150), fill: luma(248), radius: 2pt,
  inset: (x: 3pt), outset: (y: 2.5pt),
  text(size: 0.9em, body),
)

#show quote.where(block: true): it => block(
  stroke: (left: 2pt + luma(200)), inset: (left: 10pt, y: 3pt),
  text(fill: luma(70), it.body),
)

#show terms: it => {
  it.children
    .map(child => [
      #strong[#child.term]
      #block(inset: (left: 1.5em, top: -0.4em))[#child.description]
      ])
    .join()
}

#set table(inset: 6pt, stroke: none)
#show table.cell.where(y: 0): set text(weight: "bold")
#show figure.where(kind: table): set figure.caption(position: top)
#show figure.where(kind: image): set figure.caption(position: bottom)

$if(title)$
#set document(title: [$title$])
$endif$
#set page(
  paper: "$if(papersize)$$papersize$$else$a4$endif$",
  margin: $if(margin)$$margin$$else$2.5cm$endif$,
  numbering: "1",
)
#set par(justify: false)
#set text(
  lang: "$if(lang)$$lang$$else$en$endif$",
  font: ($if(mainfont)$"$mainfont$", $endif$"Noto Sans", "Symbola"),
  size: $if(fontsize)$$fontsize$$else$10.5pt$endif$,
)
#show raw: set text(font: ($if(monofont)$"$monofont$", $endif$"Noto Sans Mono", "Symbola"), size: 1.15em)
#show heading: set block(above: 1.6em, below: 0.9em)
#show raw.where(block: true): block.with(fill: luma(245), inset: 8pt, radius: 3pt, width: 100%)
// Mermaid diagrams (merman, rendered without a browser). Mermaid sizes text at 16px, so scale
// to 70% to match body text, centred and never wider than the text area. Invalid diagrams show
// an error box instead of failing the PDF.
#let render-mermaid = show-mermaid-blocks(width: auto, theme: (fontFamily: "Noto Sans"))
#show raw.where(lang: "mermaid"): it => layout(size => {
  let img = render-mermaid(it)
  let w = measure(img).width
  let factor = if w > 0pt { calc.min(0.7, size.width / w) } else { 1 }
  align(center, scale(factor * 100%, reflow: true, img))
})
#show link: set text(fill: rgb("#1a4fd8"))
$if(section-numbering)$
#set heading(numbering: "$section-numbering$")
$endif$
$if(smart)$
$else$
#set smartquote(enabled: false)
$endif$
$for(header-includes)$
$header-includes$
$endfor$

$if(title)$
#block(below: 1.8em, stack(
  spacing: 1.1em,
  text(size: 1.8em, weight: "bold")[$title$],
$if(subtitle)$
  text(size: 1.2em)[$subtitle$],
$endif$
$if(author)$
  text(size: 1.1em)[$for(author)$$author$$sep$, $endfor$],
$endif$
$if(date)$
  [$date$],
$endif$
))
$endif$

$for(include-before)$
$include-before$

$endfor$
$if(toc)$
#outline(title: auto, depth: $if(toc-depth)$$toc-depth$$else$3$endif$)

$endif$
$body$
$for(include-after)$

$include-after$
$endfor$
